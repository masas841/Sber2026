HOST=0.0.0.0
PORT=8768
GAME_DURATION_SEC=59
HIT_PADDING_PX=10

# Лог игр для дневной статистики
PLAY_LOG_FILE=data/plays.jsonl
PLAY_LOG_TZ=Europe/Moscow

# Диагностика: отправка логов киоска на photo_receiver.
LOG_UPLOAD_ENABLED=true
LOG_UPLOAD_URL=https://sberfest2026.ru
# LOG_UPLOAD_API_KEY=
LOG_UPLOAD_AUTH=bearer
# LOG_UPLOAD_KIOSK_ID=insure-chill-kiosk-1
LOG_UPLOAD_INTERVAL_SEC=60
LOG_UPLOAD_PATHS=data/srv_out.log;data/srv_err.log;server.log;data/plays.jsonl;data/games.jsonl
LOG_UPLOAD_MAX_BYTES=524288
LOG_UPLOAD_INITIAL_TAIL_BYTES=262144

# HTTPS (опционально):
# USE_HTTPS=true
# SSL_CERTFILE=certs/cert.pem
# SSL_KEYFILE=certs/key.pem

# Updater (optional): downloads the latest insure-chill folder from GitHub before launch.
AUTO_UPDATE_FROM_GITHUB=false
UPDATE_REPO_REF=main
UPDATE_MANIFEST_URL=https://cdn.jsdelivr.net/gh/masas841/Sber2026@main/insure-chill/install/update-manifest.json
UPDATE_RAW_BASE_URL=https://cdn.jsdelivr.net/gh/masas841/Sber2026@main/insure-chill
UPDATE_REPO_ARCHIVE_URL=https://github.com/masas841/Sber2026/archive/refs/heads/main.zip
# UPDATE_GITHUB_TOKEN=
