HOST=0.0.0.0
PORT=8766

# Сброс таблицы лидеров в полночь (локальное время сервера)
LEADERBOARD_RESET_HOUR=0

# Длина раунда (сек)
GAME_DURATION_SEC=60

# Джойстик: мёртвая зона стика 0..1
JOYSTICK_DEADZONE=0.35

# Лог игр для дневной статистики
PLAY_LOG_FILE=data/plays.jsonl
PLAY_LOG_TZ=Europe/Moscow

# Updater (optional): downloads the latest sberkopilka folder from GitHub before launch.
AUTO_UPDATE_FROM_GITHUB=false
UPDATE_REPO_REF=main
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/masas841/Sber2026/main/sberkopilka/install/update-manifest.json
UPDATE_RAW_BASE_URL=https://raw.githubusercontent.com/masas841/Sber2026/main/sberkopilka
UPDATE_REPO_ARCHIVE_URL=https://github.com/masas841/Sber2026/archive/refs/heads/main.zip
# UPDATE_GITHUB_TOKEN=
